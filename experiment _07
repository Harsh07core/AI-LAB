        "# BFS\n",
        "\n",
        "from collections import deque\n",
        "\n",
        "\n",
        "def is_goal(state):\n",
        "    return state[3] == True\n",
        "\n",
        "\n",
        "def get_successors(state):\n",
        "    successors = []\n",
        "    monkey_pos, box_pos, on_box, has_banana = state\n",
        "\n",
        "    locations = [\"A\", \"B\", \"C\"]\n",
        "\n",
        "\n",
        "    if not on_box:\n",
        "        for loc in locations:\n",
        "            if loc != monkey_pos:\n",
        "                successors.append(((loc, box_pos, False, False),\n",
        "                                   f\"Monkey walks to {loc}\"))\n",
        "\n",
        "\n",
        "    if monkey_pos == box_pos and not on_box:\n",
        "        for loc in locations:\n",
        "            if loc != monkey_pos:\n",
        "                successors.append(((loc, loc, False, False),\n",
        "                                   f\"Monkey pushes box to {loc}\"))\n",
        "\n",
        "\n",
        "    if monkey_pos == box_pos and not on_box:\n",
        "        successors.append(((monkey_pos, box_pos, True, False),\n",
        "                           \"Monkey climbs the box\"))\n",
        "\n",
        "\n",
        "    if monkey_pos == box_pos and on_box:\n",
        "        successors.append(((monkey_pos, box_pos, True, True),\n",
        "                           \"Monkey grabs the banana\"))\n",
        "\n",
        "    return successors\n",
        "\n",
        "\n",
        "def bfs(initial_state):\n",
        "    queue = deque()\n",
        "    queue.append((initial_state, []))\n",
        "    visited = set()\n",
        "\n",
        "    while queue:\n",
        "        current_state, path = queue.popleft()\n",
        "\n",
        "        if current_state in visited:\n",
        "            continue\n",
        "\n",
        "        visited.add(current_state)\n",
        "\n",
        "        if is_goal(current_state):\n",
        "            return path\n",
        "\n",
        "        for next_state, action in get_successors(current_state):\n",
        "            if next_state not in visited:\n",
        "                queue.append((next_state, path + [action]))\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "initial_state = (\"A\", \"B\", False, False)\n",
        "\n",
        "solution = bfs(initial_state)\n",
        "\n",
        "if solution:\n",
        "    print(\"Solution found using BFS:\\n\")\n",
        "    for step in solution:\n",
        "        print(step)\n",
        "else:\n",
        "    print(\"No solution found.\")"
